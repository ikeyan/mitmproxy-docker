# mitmproxy Web UI へのログインパスワード
WEB_PASSWORD=password

# Tailscale の auth key（https://login.tailscale.com/admin/settings/keys で発行）
# 空のままでも起動でき、その場合は `docker compose logs tailscale` に出るURLからログインする。
TS_AUTHKEY=

# tailnet 上でのノード名
TS_HOSTNAME=mitm-exit

# exit node が待ち受ける UDP ポート（Mac 本体の Tailscale が 41641 を使うのでずらす）
TS_PORT=41642

# LAN 内の端末から直接つながるよう広告するエンドポイント（Mac の LAN IP:TS_PORT）
# 空なら広告しない（その場合 DERP 中継経由になることがある）。例: 192.168.1.150:41642
TS_ENDPOINT=
